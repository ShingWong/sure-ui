{
  "name": "@shing.wong/sure-ui",
  "version": "0.2.0",
  "description": "UI component library for sure-factor generated interfaces — forms, data tables, modals, and CRUD layouts with accessibility and theme support.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "author": "ShingWong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShingWong/sure-ui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./compose": {
      "types": "./dist/compose.d.ts",
      "import": "./dist/compose.js"
    },
    "./themes": {
      "types": "./dist/styles/index.d.ts",
      "import": "./dist/styles/index.js"
    }
  },
  "files": [
    "dist",
    "fonts",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "ui",
    "components",
    "forms",
    "tables",
    "accessibility"
  ],
  "sideEffects": false
}
